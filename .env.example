APP_NAME=KisiKisi AI
APP_ENV=development
DEBUG=true

SECRET_KEY=change-this-to-a-long-random-secret-key

DATABASE_URL=postgresql+psycopg://dev:password@127.0.0.1:5432/tesis_kisikisi

# AI provider: API key remains in environment and is never stored in the database.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

STORAGE_PATH=storage
MAX_UPLOAD_SIZE=10485760
TIMEZONE=Asia/Jakarta

SESSION_COOKIE_NAME=kisikisi_session
SESSION_MAX_AGE=28800

CSRF_COOKIE_NAME=kisikisi_csrf
CSRF_MAX_AGE=3600

ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=Admin123456!
ADMIN_NAME=Administrator
