# Python
__pycache__/
*.py[cod]
*.so

# Virtual environment
.venv/
.venv-revision/

# Environment
.env

# Testing
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Revision documentation and automation are tracked; generated evidence stays local
/docs/revision/reports/
/docs/revision/testing/test_evidence/*
!/docs/revision/testing/test_evidence/README.md
/docs/revision/screenshots/*
!/docs/revision/screenshots/README.md

# Ruff
.ruff_cache/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Application storage
logs/
storage/materials/*
storage/references/*
storage/exports/*
storage/generation_private/*

# Keep storage directories
!storage/materials/.gitkeep
!storage/references/.gitkeep
!storage/exports/.gitkeep
